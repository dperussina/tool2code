{
  "name": "tool2code",
  "version": "0.0.0",
  "description": "Compile a tool catalogue into an interface models choose from correctly. Measured: +12.5 points over raw JSON Schema on a badly-structured catalogue.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build",
    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.13.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tool2code": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "tools",
    "llm",
    "tool-calling",
    "json-schema",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dperussina/tool2code.git"
  }
}
